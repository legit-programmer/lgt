{
  "settings": {
    "data_dir": "~/.lgt",
    "max_hops": 3,
    "tool_output_cap": 65536,
    "concurrent_runs": 4,
    "replay_cap": 5000,
    "startup_timeout_seconds": 30,
    "checkpoint_timeout_seconds": 30,
    "session_ttl_seconds": null,
    "checkpoint_claude_model": "haiku",
    "checkpoint_codex_model": null,
    "checkpoint_attempts": 2,
    "ndjson_line_limit": 1048576,
    "cancel_grace_seconds": 5,
    "checkpoint_threshold": 100000,
    "checkpoint_tail_chars": 25000,
    "checkpoint_summary_chars": 10000,
    "attachment_max_bytes": 26214400,
    "attachment_channel_quota_bytes": 262144000,
    "attachment_retention_seconds": 86400,
    "thumbnail_max_dimension": 512,
    "allowed_origins": [],
    "listen_host": "127.0.0.1",
    "listen_port": 8000,
    "advertised_url": null
  },
  "checkpoint_mode": "deferred",
  "codex_bin": null,
  "claude_command": ["claude"],
  "codex_checkpoint_command": null,
  "gemini_command": ["gemini"]
}
