{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Folder pickers, opening attachments, the app-drawn title bar's window controls, and the frosted window effect.",
  "windows": [
    "main"
  ],
  "platforms": [
    "linux",
    "macOS",
    "windows"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "opener:allow-open-url",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-effects"
  ]
}
